      backgroundColor: COLORS.slate, borderRadius:4
    }]
  },
  options:{
    responsive:true, maintainAspectRatio:false,
    plugins:{ legend:{display:false}, tooltip:{callbacks:{label:c=>fmt(c.parsed.y)+'개'}} },
    scales:{
      x:{ grid:{display:false} },
      y:{ ticks:{ callback:v=>fmt(v) }, grid:{color:'#EDF3EE'} }
    }
  }
});

