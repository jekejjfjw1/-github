  '음식':COLORS.line, '소매':COLORS.amber, '수리·개인':COLORS.slate, '과학·기술':COLORS.rose,
  '교육':COLORS.violet, '예술·스포츠':COLORS.teal, '부동산':COLORS.ochre, '보건의료':COLORS.olive,
  '시설관리·임대':COLORS.grey, '숙박':COLORS.mauve
};

Chart.defaults.font.family = "-apple-system,BlinkMacSystemFont,'Apple SD Gothic Neo','Malgun Gothic','Noto Sans KR',sans-serif";
Chart.defaults.color = '#4B5D52';
Chart.defaults.borderColor = '#DCE6DE';

const fmt = n => n.toLocaleString('ko-KR');

/* ---- hero stats ---- */
const totalRidership = DATA.stations.reduce((s,d)=>s+d.ridership,0);
const totalShops500 = DATA.stations.reduce((s,d)=>s+d.shops500,0);
const totalOffice500 = DATA.stations.reduce((s,d)=>s+d.office500,0);
document.getElementById('stat-row').innerHTML = `
  <div class="stat"><div class="stat-num">43</div><div class="stat-label">2호선 전체 역 수</div></div>
  <div class="stat"><div class="stat-num">${fmt(totalRidership)}</div><div class="stat-label">일평균 총 승하차 인원(명)</div></div>
  <div class="stat"><div class="stat-num">${fmt(totalShops500)}</div><div class="stat-label">역세권(500m) 내 상가 합계</div></div>
  <div class="stat"><div class="stat-num">${fmt(totalOffice500)}</div><div class="stat-label">역세권(500m) 내 오피스형 업체</div></div>
`;

/* ---- line map (signature svg) ---- */
(function(){
  const svg = document.getElementById('linemap');
  const n = DATA.stations.length;
  const stepX = 42;
  const w = Math.max(1080, n*stepX + 80);
  svg.setAttribute('width', w);
  svg.setAttribute('viewBox', `0 0 ${w} 150`);
  const midY = 75;
  const maxR = Math.sqrt(Math.max(...DATA.stations.map(d=>d.ridership)));
  const nsMap = "http://www.w3.org/2000/svg";
  const lineEl = document.createElementNS(nsMap,'line');
  lineEl.setAttribute('x1', 40); lineEl.setAttribute('x2', w-40);
  lineEl.setAttribute('y1', midY); lineEl.setAttribute('y2', midY);
  lineEl.setAttribute('stroke', '#1E8E4F'); lineEl.setAttribute('stroke-width', 4);
  lineEl.setAttribute('stroke-linecap','round');
  svg.appendChild(lineEl);

  const highlight = ['서면','사상','센텀시티','장산','양산'];
  const tooltip = document.getElementById('linemapTooltip');
  const scrollBox = document.querySelector('.linemap-scroll');

  DATA.stations.forEach((d,i)=>{
    const x = 40 + i*stepX;
    const r = 4 + (Math.sqrt(d.ridership)/maxR)*16;
    const c = document.createElementNS(nsMap,'circle');
    c.setAttribute('cx', x); c.setAttribute('cy', midY); c.setAttribute('r', r.toFixed(1));
    c.setAttribute('fill', highlight.includes(d.name) ? '#E8A33D' : '#1E8E4F');
    c.setAttribute('fill-opacity', highlight.includes(d.name) ? '1' : '0.85');
    c.setAttribute('stroke', '#FFFFFF'); c.setAttribute('stroke-width', '2');
    c.style.cursor = 'pointer';

    const showTip = (evt)=>{
      tooltip.textContent = `${d.name}역 · 일평균 ${fmt(d.ridership)}명`;
      const boxRect = scrollBox.getBoundingClientRect();
      const svgRect = svg.getBoundingClientRect();
      const left = (svgRect.left - boxRect.left) + (x / w) * svgRect.width + scrollBox.scrollLeft;
      tooltip.style.left = left + 'px';
      tooltip.style.top = (midY - r) + 'px';
      tooltip.classList.add('show');
    };
    const hideTip = ()=> tooltip.classList.remove('show');

    c.addEventListener('mouseenter', showTip);
    c.addEventListener('mousemove', showTip);
    c.addEventListener('mouseleave', hideTip);
    c.addEventListener('touchstart', showTip, {passive:true});
    c.addEventListener('touchend', hideTip);

    svg.appendChild(c);
    if(highlight.includes(d.name)){
      const t = document.createElementNS(nsMap,'text');
      t.setAttribute('x', x); t.setAttribute('y', midY - r - 10);
      t.setAttribute('text-anchor','middle'); t.setAttribute('font-size','12');
      t.setAttribute('font-weight','700'); t.setAttribute('fill','#146538');
      t.setAttribute('pointer-events','none');
      t.textContent = d.name;
      svg.appendChild(t);
    }
  });
})();

/* ---- chart 1: ridership in line order ---- */
new Chart(document.getElementById('chartRidership'), {
  type:'bar',
  data:{
    labels: DATA.stations.map(d=>d.name),
    datasets:[{
      label:'일평균 승하차(명)',
      data: DATA.stations.map(d=>d.ridership),
      backgroundColor: DATA.stations.map(d=> d.name==='서면' ? COLORS.amber : COLORS.line),
      borderRadius:3, maxBarThickness:14
    }]
  },
  options:{
    responsive:true, maintainAspectRatio:false,
    plugins:{ legend:{display:false}, tooltip:{callbacks:{label:c=>fmt(c.parsed.y)+'명'}} },
    scales:{
      x:{ ticks:{ autoSkip:false, maxRotation:90, minRotation:90, font:{size:10} }, grid:{display:false} },
      y:{ ticks:{ callback:v=>fmt(v) }, grid:{color:'#EDF3EE'} }
    }
  }
});

/* ---- chart 2: shops top 15 ---- */
const shopsTop = [...DATA.stations].sort((a,b)=>b.shops500-a.shops500).slice(0,15);
new Chart(document.getElementById('chartShops'), {
  type:'bar',
  data:{
    labels: shopsTop.map(d=>d.name),
    datasets:[{
      label:'상가수(500m)',
      data: shopsTop.map(d=>d.shops500),
      backgroundColor: COLORS.amber, borderRadius:4
    }]
  },
  options:{
    indexAxis:'y',
    responsive:true, maintainAspectRatio:false,
    plugins:{ legend:{display:false}, tooltip:{callbacks:{label:c=>fmt(c.parsed.x)+'개'}} },
    scales:{
      x:{ ticks:{ callback:v=>fmt(v) }, grid:{color:'#EDF3EE'} },
      y:{ grid:{display:false} }
    }
  }
});

/* ---- chart 3: category donut ---- */
const catEntries = Object.entries(DATA.categoryTotals).sort((a,b)=>b[1]-a[1]);
new Chart(document.getElementById('chartMix'), {
  type:'doughnut',
  data:{
    labels: catEntries.map(e=>e[0]),
    datasets:[{
      data: catEntries.map(e=>e[1]),
      backgroundColor: catEntries.map(e=>CAT_COLORS[e[0]]),
      borderColor:'#FFFFFF', borderWidth:2
    }]
  },
  options:{
    responsive:true, maintainAspectRatio:false,
    cutout:'58%',
    plugins:{
      legend:{ position:'right', labels:{ boxWidth:12, font:{size:11.5} } },
      tooltip:{ callbacks:{ label:c=>{
        const total = catEntries.reduce((s,e)=>s+e[1],0);
        const pct = (c.parsed/total*100).toFixed(1);
        return `${c.label}: ${fmt(c.parsed)}개 (${pct}%)`;
      } } }
    }
  }
});

/* ---- chart 4: office top 10 ---- */
const officeTop = [...DATA.stations].sort((a,b)=>b.office500-a.office500).slice(0,10);
new Chart(document.getElementById('chartOffice'), {
  type:'bar',
  data:{
