
import pandas as pd

# ① 데이터 불러오기
시설 = pd.read_csv(
    "부산광역시_노인요양시설현황_20260831.csv",
    encoding="cp949"
)

인구 = pd.read_csv(
    "2025_2025_행정동별 세대주 성연령별 현황_연간.csv",
    encoding="cp949"
)

# ② 인구 데이터 정제
# 부산광역시 전체 행은 제외하고 구·군 이름 추출
인구 = 인구[
    인구["행정구역"].str.contains(
        r"부산광역시 .+ \(", na=False
    )
].copy()

인구["구군"] = 인구["행정구역"].str.extract(
    r"부산광역시 (.+?) \("
)

# 실제 인구수 열은 '연령구간인구수'
숫자열 = [
    "2025년_계_연령구간인구수",
    "2025년_계_60~69세",
    "2025년_계_70~79세",
    "2025년_계_80~89세",
    "2025년_계_90~99세",
    "2025년_계_100세 이상"
]

for 열 in 숫자열:
    인구[열] = pd.to_numeric(
        인구[열].astype(str).str.replace(",", "", regex=False),
        errors="coerce"
    )

인구["총인구"] = 인구["2025년_계_연령구간인구수"]

# ⚠️ 65세 이상 인구가 직접 제공되지 않으므로
# 60~69세 인구의 절반을 65~69세 인구로 추정
인구["고령인구추정"] = (
    인구["2025년_계_60~69세"] * 0.5
    + 인구["2025년_계_70~79세"]
    + 인구["2025년_계_80~89세"]
    + 인구["2025년_계_90~99세"]
    + 인구["2025년_계_100세 이상"]
)

인구["고령인구비율"] = (
    인구["고령인구추정"] / 인구["총인구"] * 100
)

# ③ 구·군별 시설 수 계산
시설수 = (
    시설.groupby("구군")
    .size()
    .reset_index(name="시설수")
)

# 구·군 이름을 기준으로 결합
자료 = pd.merge(
    인구,
    시설수,
    on="구군",
    how="left"
)

자료["시설수"] = 자료["시설수"].fillna(0)

자료["인구1000명당시설수"] = (
    자료["시설수"] / 자료["고령인구추정"] * 1000
)

# ④ 추가 조건: 고령 인구 추정치가 중앙값 이상
중앙값 = 자료["고령인구추정"].median()

대상 = 자료[
    (자료["고령인구비율"] >= 20) &
    (자료["인구1000명당시설수"] < 15) &
    (자료["고령인구추정"] >= 중앙값)
].copy()

# ⑤ 시설 공급률이 낮은 순으로 상위 3개 출력
상위3개 = 대상.sort_values(
    "인구1000명당시설수",
    ascending=True
).head(3)

print("===== 고령층 생활시설 지원 우선 검토 지역 TOP 3 =====")

print(
    상위3개[
        [
            "구군",
            "총인구",
            "고령인구추정",
            "고령인구비율",
            "시설수",
            "인구1000명당시설수"
        ]
    ].round(2).to_string(index=False)
)

# 구·군 이름과 시설 수가 제대로 결합됐는지 확인
print("\n===== 구·군별 시설 수 확인 =====")
print(자료[["구군", "시설수"]].sort_values("구군").to_string(index=False))
