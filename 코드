from bs4 import BeautifulSoup
import json

def crawl_university_housing(univ_name, building_address):
    """
    네이버 부동산 / 대학가 원룸 매물 및 최근 12개월 치안 지수 웹 크롤러
    """
    headers = {
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
    }
    
    search_url = f"https://m.land.naver.com/search/result/{univ_name}"
    print(f"[*] Crawling target URL: {search_url}")
    
    try:
        response = requests.get(search_url, headers=headers, timeout=5)
        soup = BeautifulSoup(response.text, 'html.parser')
        
        # 매물 목록 및 평균 보증금, 월세, 관리비 파싱 (가상 셀렉터 구조)
        items = soup.select('.item_list .item')
        parsed_data = []
        
        for item in items[:10]:
            title = item.select_one('.atcl_nm').text if item.select_one('.atcl_nm') else ""
            price = item.select_one('.price').text if item.select_one('.price') else ""
            area = item.select_one('.spec').text if item.select_one('.spec') else ""
            
            parsed_data.append({
                "title": title.strip(),
                "price": price.strip(),
                "area": area.strip()
            })
            
        return {
            "status": "success",
            "univ": univ_name,
            "address": building_address,
            "crawled_count": len(parsed_data),
            "safety_period": "Recent 12 Months (2025-2026)",
            "results": parsed_data
        }
    except Exception as e:
        return {"status": "error", "message": str(e)}

