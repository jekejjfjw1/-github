            const customInput = document.getElementById('pyeongCustomInput');
            
            if (selectVal === 'custom') {
                customInput.disabled = false;
                customInput.classList.remove('bg-slate-100', 'text-slate-400');
                customInput.classList.add('bg-white', 'text-brand-600');
                customInput.focus();
            } else {
                customInput.value = selectVal;
                customInput.disabled = true;
                customInput.classList.remove('bg-white', 'text-brand-600');
                customInput.classList.add('bg-slate-100', 'text-slate-400');
            }
        }

        function toggleOccupancy(num) {
            currentOccupancy = num;
            const occ1Btn = document.getElementById('occ1Btn');
            const occ2Btn = document.getElementById('occ2Btn');

            if (num === 1) {
                occ1Btn.className = "cursor-pointer border rounded-lg p-2 flex items-center justify-center space-x-1.5 transition text-xs font-semibold bg-brand-50 border-brand-500 text-brand-600";
                occ2Btn.className = "cursor-pointer border rounded-lg p-2 flex items-center justify-center space-x-1.5 transition text-xs font-semibold bg-slate-50 border-slate-200 text-slate-600";
            } else {
                occ2Btn.className = "cursor-pointer border rounded-lg p-2 flex items-center justify-center space-x-1.5 transition text-xs font-semibold bg-brand-50 border-brand-500 text-brand-600";
                occ1Btn.className = "cursor-pointer border rounded-lg p-2 flex items-center justify-center space-x-1.5 transition text-xs font-semibold bg-slate-50 border-slate-200 text-slate-600";
            }
        }

        function toggleLeaseType(type) {
            currentLeaseType = type;
            const monthlyBtn = document.getElementById('leaseMonthlyBtn');
            const jeonseBtn = document.getElementById('leaseJeonseBtn');
            const rentContainer = document.getElementById('rentInputContainer');
            const depositLabel = document.getElementById('depositLabel');

            if (type === 'monthly') {
                monthlyBtn.className = "cursor-pointer border rounded-lg p-2 flex items-center justify-center space-x-1.5 transition text-xs font-semibold bg-brand-50 border-brand-500 text-brand-600";
                jeonseBtn.className = "cursor-pointer border rounded-lg p-2 flex items-center justify-center space-x-1.5 transition text-xs font-semibold bg-slate-50 border-slate-200 text-slate-600";
                rentContainer.style.display = 'block';
                depositLabel.textContent = '보증금(만)';
            } else {
                jeonseBtn.className = "cursor-pointer border rounded-lg p-2 flex items-center justify-center space-x-1.5 transition text-xs font-semibold bg-brand-50 border-brand-500 text-brand-600";
                monthlyBtn.className = "cursor-pointer border rounded-lg p-2 flex items-center justify-center space-x-1.5 transition text-xs font-semibold bg-slate-50 border-slate-200 text-slate-600";
                rentContainer.style.display = 'none';
                depositLabel.textContent = '전세금(만)';
                document.getElementById('depositInput').value = "10000";
            }
        }

        function onUniversityChange() {
            // Updated dynamically
        }

        function toggleCrawlerCodeModal() {
            const modal = document.getElementById('crawlerCodeModal');
            modal.classList.toggle('hidden');
        }

        // Web Crawler Execution Simulation & Dynamic Terminal Log Output
        function triggerCrawlerAndAnalysis() {
            const addressInput = document.getElementById('buildingAddressInput').value.trim();
            if (!addressInput) {
                alert("건물명 및 상세 위치를 입력해주세요! (예: 신촌역 6번 출구 빌라)");
                document.getElementById('buildingAddressInput').focus();
                return;
            }

            const selectedId = parseInt(document.getElementById('universitySelect').value) || 1;
            const univ = UNIVERSITIES_DB.find(u => u.id === selectedId);

            const logText = document.getElementById('crawlerLogText');
            const statusBadge = document.getElementById('crawlStatusBadge');

            statusBadge.textContent = "Crawling...";
            statusBadge.className = "text-[10px] bg-amber-950 text-amber-300 border border-amber-800 px-2 py-0.5 rounded animate-pulse";

            logText.innerHTML = `
                <p class="text-emerald-400">> [1/3] POST Request Sent to Naver Land & Dabang Crawler Engine...</p>
                <p class="text-slate-400">> Target: ${univ.name} (${univ.dong}) - 건물명: "${addressInput}"</p>
            `;

            setTimeout(() => {
                logText.innerHTML += `<p class="text-indigo-300">> [2/3] 최근 12개월(${univ.period}) 범죄 통계 및 치안 지수 파싱 완료...</p>`;
                logText.scrollTop = logText.scrollHeight;
            }, 600);

            setTimeout(() => {
                logText.innerHTML += `<p class="text-emerald-400 font-bold">> [3/3] 크롤링 완료! 최근 1년 기준 데이터 기반 안심 리포트를 구성합니다.</p>`;
                logText.scrollTop = logText.scrollHeight;
                
                statusBadge.textContent = "Crawl Success";
                statusBadge.className = "text-[10px] bg-emerald-950 text-emerald-300 border border-emerald-800 px-2 py-0.5 rounded";

                startAnalysis();
            }, 1200);
        }

        function startAnalysis() {
            const addressInput = document.getElementById('buildingAddressInput').value.trim() || "입력 매물";
            document.getElementById('targetBuildingDisplay').textContent = addressInput;

            const selectedId = parseInt(document.getElementById('universitySelect').value) || 1;
            const univ = UNIVERSITIES_DB.find(u => u.id === selectedId);
            
            const pyeong = parseFloat(document.getElementById('pyeongCustomInput').value) || 7;
            const deposit = parseInt(document.getElementById('depositInput').value) || 1000;
            const rent = currentLeaseType === 'monthly' ? (parseInt(document.getElementById('rentInput').value) || 50) : 0;
            const maint = parseInt(document.getElementById('maintInput').value) || 8;

            const pyeongSqM = (pyeong * 3.3058).toFixed(1);

            const spacePercent = Math.min(Math.max((pyeong / 15) * 100, 15), 100);
            document.getElementById('spaceProgressBar').style.width = `${spacePercent}%`;

            let pyeongTagText = "표준";
            let pyeongExplanation = "";
            let furnitureItems = [];

            // 1-Person vs 2-Person Furniture & Occupancy Rules
            if (currentOccupancy === 1) {
                document.getElementById('occupancyBadgeHeader').textContent = "1인 가구 추천";
                document.getElementById('occupancyNoteText').textContent = "💡 1인 가구 실거주에 적합한 가구 및 동선 배치입니다.";

                if (pyeong <= 5.5) {
                    pyeongTagText = "초소형 (1인)";
                    pyeongExplanation = "1인 거주 / 침대+책상 타이트함";
                    furnitureItems = [
                        { name: '싱글 침대', icon: 'fa-bed', state: 'ok' },
                        { name: '미니 책상', icon: 'fa-desktop', state: 'ok' },
                        { name: '소형 행거', icon: 'fa-shirt', state: 'ok' },
                        { name: '소파/식탁', icon: 'fa-couch', state: 'no' }
                    ];
                } else if (pyeong <= 8.5) {
                    pyeongTagText = "표준 원룸 (1인)";
                    pyeongExplanation = "1인 최적 / 가구 여유배치 가능";
                    furnitureItems = [
                        { name: '슈퍼싱글 침대', icon: 'fa-bed', state: 'ok' },
                        { name: '독서/컴퓨터 책상', icon: 'fa-laptop', state: 'ok' },
                        { name: '옷장/수납장', icon: 'fa-door-closed', state: 'ok' },
                        { name: '빨래 건조대 공간', icon: 'fa-shirt', state: 'ok' },
                        { name: '2인용 소파', icon: 'fa-couch', state: 'tight' }
                    ];
                } else {
                    pyeongTagText = "대형 원룸/1.5룸";
                    pyeongExplanation = "1인 쾌적 / 소파 및 홈오피스 가능";
                    furnitureItems = [
                        { name: '퀸 사이즈 침대', icon: 'fa-bed', state: 'ok' },
                        { name: '대형 책상/작업대', icon: 'fa-desktop', state: 'ok' },
                        { name: '2인 소파 & TV장', icon: 'fa-tv', state: 'ok' },
                        { name: '식탁/아일랜드', icon: 'fa-utensils', state: 'ok' }
                    ];
                }
            } else {
                // 2-Person Occupancy Rules
                document.getElementById('occupancyBadgeHeader').textContent = "2인 가구(룸메) 기준";

                if (pyeong <= 7.5) {
                    pyeongTagText = "2인 거주 협소";
                    pyeongExplanation = "2인 거주 시 좁음 / 2층 침대 필수";
                    document.getElementById('occupancyNoteText').textContent = "⚠️ 2인 거주 시 공간이 다소 협소할 수 있습니다.";
                    furnitureItems = [
                        { name: '2층 침대 / 싱글2', icon: 'fa-bed', state: 'tight' },
                        { name: '2인 책상 동선', icon: 'fa-laptop', state: 'tight' },
                        { name: '수납 공간 분리', icon: 'fa-door-closed', state: 'no' },
                        { name: '독립 거실', icon: 'fa-couch', state: 'no' }
                    ];
                } else if (pyeong <= 11.5) {
                    pyeongTagText = "2인 알뜰 (1.5룸)";
                    pyeongExplanation = "2인 거주 가능 / 비용 절감 효과";
                    document.getElementById('occupancyNoteText').textContent = "💡 2인이 함께 생활하며 월세를 절약하기 좋습니다.";
                    furnitureItems = [
                        { name: '싱글 침대 2개', icon: 'fa-bed', state: 'ok' },
                        { name: '각자 책상 2개', icon: 'fa-desktop', state: 'ok' },
                        { name: '옷장 분리 수납', icon: 'fa-door-closed', state: 'ok' },
                        { name: '소형 소파', icon: 'fa-couch', state: 'tight' }
                    ];
                } else {
                    pyeongTagText = "2인 추천 (투룸)";
                    pyeongExplanation = "독립 방 2개 / 2인 최적 생활";
                    document.getElementById('occupancyNoteText').textContent = "✨ 방 분리가 가능하여 2인 독립 생활에 가장 좋습니다.";
                    furnitureItems = [
                        { name: '독립 침실 가구 2세트', icon: 'fa-bed', state: 'ok' },
                        { name: '공용 거실 소파', icon: 'fa-couch', state: 'ok' },
                        { name: '드레스룸 / 옷장', icon: 'fa-door-closed', state: 'ok' },
                        { name: '2인 수용 공간', icon: 'fa-users', state: 'ok' }
                    ];
                }
            }

            document.getElementById('spaceTag').textContent = pyeongTagText;
            document.getElementById('summarySpaceGrade').textContent = `${pyeong}평 (${pyeongSqM}㎡)`;
            document.getElementById('summarySpaceDesc').textContent = pyeongExplanation;

            document.getElementById('detailPyeongHeader').textContent = `${pyeong}평 (${pyeongSqM}㎡)`;
            document.getElementById('blueprintDimText').textContent = `📐 약 ${(Math.sqrt(pyeong*3.3)*0.9).toFixed(1)}m × ${(Math.sqrt(pyeong*3.3)*1.1).toFixed(1)}m (${pyeongSqM}㎡)`;

            renderBlueprintFurniture(furnitureItems);

            // Price Assessment calculation
            const totalMonthlySpend = currentLeaseType === 'monthly' ? (rent + maint) : Math.round((deposit * 0.04) / 12) + maint;
            const perPersonSpend = currentOccupancy === 2 ? Math.round(totalMonthlySpend / 2) : totalMonthlySpend;
            
            const avgDiff = totalMonthlySpend - (univ.avgRent + univ.avgMaint);
            
            let priceTag = "적정";
            let priceDescText = currentOccupancy === 2 ? `1인당 약 ${perPersonSpend}만원 절감` : "대학가 평균 시세 수준";
            let priceBarVal = 50;

            if (avgDiff > 10) {
                priceTag = "높음";
                if (currentOccupancy === 1) priceDescText = "시세 대비 고비용";
                priceBarVal = 85;
            } else if (avgDiff < -5) {
                priceTag = "알뜰";
                if (currentOccupancy === 1) priceDescText = "시세 대비 저렴함";
                priceBarVal = 25;
            }

            document.getElementById('priceTag').textContent = priceTag;
            document.getElementById('summaryPriceGrade').textContent = currentOccupancy === 2 ? `총 ${totalMonthlySpend}만 (인당 ${perPersonSpend}만)` : `월 ${totalMonthlySpend}만`;
            document.getElementById('summaryPriceDesc').textContent = priceDescText;
            document.getElementById('priceProgressBar').style.width = `${priceBarVal}%`;

            // Safety & Data Recency Calculation
            let fraudScore = univ.safetyScore;
            if (maint >= 10) fraudScore -= 5;
            if (deposit >= 5000 && currentLeaseType === 'monthly') fraudScore -= 10;

            document.getElementById('summarySafetyGrade').textContent = `${fraudScore}점`;
            document.getElementById('safetyProgressBar').style.width = `${fraudScore}%`;
            document.getElementById('safetyTag').textContent = fraudScore >= 80 ? '안심' : '주의';

            // Recency Period Display Updates
            document.getElementById('safetyRecencyBadge').textContent = univ.period;
            document.getElementById('gaugePeriodTag').textContent = univ.period;
            document.getElementById('summarySafetyDesc').textContent = univ.recencyStatus;
            document.getElementById('safetyReasonText').innerHTML = `<strong>최근 1년 치안 상태 (${univ.period}):</strong> ${univ.district} ${univ.dong} 일대의 최근 범죄율, CCTV 밀집도 및 여성안심귀가길 통계를 바탕으로 분석된 최신 지수입니다.<br><span class="text-emerald-700 font-semibold">💡 ${univ.recencyStatus}</span>`;

            // Update Pyeong Catalogue
            document.getElementById('selectedUnivNameDisplay').textContent = `${univ.name} 주변 기준`;
            if (currentLeaseType === 'monthly') {
                const baseRent = univ.avgRent;
                document.getElementById('p5Rent').textContent = `월 ${Math.round(baseRent * 0.85)}만`;
                document.getElementById('p7Rent').textContent = `월 ${baseRent}만`;
                document.getElementById('p10Rent').textContent = `월 ${Math.round(baseRent * 1.3)}만`;
                document.getElementById('p15Rent').textContent = `월 ${Math.round(baseRent * 1.8)}만`;
            } else {
                const baseJeonse = univ.avgJeonse;
                document.getElementById('p5Rent').textContent = `전세 ${(baseJeonse * 0.85).toLocaleString()}만`;
                document.getElementById('p7Rent').textContent = `전세 ${baseJeonse.toLocaleString()}만`;
                document.getElementById('p10Rent').textContent = `전세 ${(baseJeonse * 1.35).toLocaleString()}만`;
                document.getElementById('p15Rent').textContent = `전세 ${(baseJeonse * 1.8).toLocaleString()}만`;
            }

            // Update Visual Charts
            if (currentLeaseType === 'monthly') {
                renderCharts(rent, maint, univ.avgRent, univ.avgMaint, fraudScore, "월세", "관리비");
            } else {
                renderCharts(deposit / 100, maint, univ.avgJeonse / 100, univ.avgMaint, fraudScore, "전세금(억)", "관리비");
            }
        }

        function renderBlueprintFurniture(items) {
            const grid = document.getElementById('blueprintFurnitureGrid');
            const badgeList = document.getElementById('furnitureBadgeList');
            
            grid.innerHTML = '';
            badgeList.innerHTML = '';

            items.forEach(item => {
                const box = document.createElement('div');
                let bgStyle = "bg-indigo-900/60 border-indigo-500/50 text-indigo-200";
                if (item.state === 'tight') bgStyle = "bg-amber-900/40 border-amber-500/50 text-amber-300";
                if (item.state === 'no') bgStyle = "bg-rose-950/40 border-rose-800/40 text-slate-500 opacity-40 line-through";

                box.className = `p-2.5 rounded-lg border flex flex-col items-center justify-center text-center space-y-1 ${bgStyle} min-w-[70px] flex-1`;
                box.innerHTML = `
                    <i class="fa-solid ${item.icon} text-base"></i>
                    <span class="text-[10px] font-bold">${item.name}</span>
                `;
                grid.appendChild(box);

                const badge = document.createElement('div');
                let statusBadge = `<span class="bg-emerald-100 text-emerald-700 font-bold px-1.5 py-0.5 rounded text-[10px]">수용 가능</span>`;
                if (item.state === 'tight') statusBadge = `<span class="bg-amber-100 text-amber-700 font-bold px-1.5 py-0.5 rounded text-[10px]">동선 타이트</span>`;
                if (item.state === 'no') statusBadge = `<span class="bg-rose-100 text-rose-700 font-bold px-1.5 py-0.5 rounded text-[10px]">배치 불가</span>`;

                badge.className = "bg-slate-50 border border-slate-200/80 p-2 rounded-lg flex items-center justify-between";
                badge.innerHTML = `
                    <div class="flex items-center space-x-2">
                        <i class="fa-solid ${item.icon} text-brand-600"></i>
                        <span class="font-medium text-slate-800 text-xs">${item.name}</span>
                    </div>
                    ${statusBadge}
                `;
                badgeList.appendChild(badge);
            });
        }

        function renderCharts(mainCost, userMaint, avgMainCost, avgMaint, safetyScore, mainLabel, maintLabel) {
            const ctx1 = document.getElementById('priceComparisonChart').getContext('2d');
            if (priceChartInstance) priceChartInstance.destroy();

            priceChartInstance = new Chart(ctx1, {
                type: 'bar',
                data: {
                    labels: ['내 선택 매물', '대학가 평균'],
                    datasets: [
                        {
                            label: mainLabel,
                            data: [mainCost, avgMainCost],
                            backgroundColor: '#4f46e5',
                            borderRadius: 6
                        },
                        {
                            label: maintLabel,
                            data: [userMaint, avgMaint],
                            backgroundColor: '#94a3b8',
                            borderRadius: 6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: { stacked: true, grid: { display: false } },
                        y: { stacked: true, beginAtZero: true, grid: { color: '#f1f5f9' } }
                    },
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 10 } } }
                    }
                }
            });

            const ctx2 = document.getElementById('safetyGaugeChart').getContext('2d');
            if (safetyChartInstance) safetyChartInstance.destroy();

            safetyChartInstance = new Chart(ctx2, {
                type: 'doughnut',
                data: {
                    datasets: [{
                        data: [safetyScore, 100 - safetyScore],
                        backgroundColor: ['#4f46e5', '#e2e8f0'],
                        borderWidth: 0,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    rotation: -90,
                    circumference: 180,
                    cutout: '75%',
                    plugins: { tooltip: { enabled: false } }
                },
                plugins: [{
                    id: 'gaugeText',
                    afterDraw(chart) {
                        const { ctx, chartArea: { width, height } } = chart;
                        ctx.save();
                        ctx.font = 'bold 20px Pretendard';
                        ctx.fillStyle = '#1e1b4b';
                        ctx.textAlign = 'center';
                        ctx.fillText(`${safetyScore}점`, width / 2, height / 1.2);
                        ctx.restore();
                    }
                }]
            });
        }
    </script>
</body>
